            },
            "url": {
              "raw": "{{baseUrl}}/api/thuchi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "thuchi"
              ]
            }
          }
        },
        {
          "name": "GET /api/luong (Danh sách Lương Khoán - Payroll Read)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accountantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/luong",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "luong"
              ]
            }
          }
        }
      ]
    },
