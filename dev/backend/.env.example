PORT=3000
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_DATABASE=your_database_name

# Tests only: provide a separately created, disposable database. It must never
# resolve to DATABASE_URL and must never point to Supabase or a shared environment.
# Pytest accepts only local SQLite or loopback PostgreSQL databases ending in
# `_test`; it aborts when this is missing or unsafe, so it never uses DATABASE_URL.
# Example: TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bachkhoa_erp_test
TEST_DATABASE_URL=

SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_ADMIN_ENABLED=true

PAYOS_CLIENT_ID='your_payos_client_id'
PAYOS_API_KEY='your_payos_api_key'
PAYOS_CHECKSUM_KEY='your_payos_checksum_key'

GEMINI_API_KEY='your_gemini_api_key'

# MinIO (file storage) — docker-compose.dev.yml overrides MINIO_ENDPOINT/PUBLIC_URL
# for the backend container automatically. These defaults match the bundled
# `minio` service, so `docker compose -f docker-compose.dev.yml up` works out
# of the box on a fresh clone without editing anything below.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wiki-files
MINIO_PUBLIC_URL=http://localhost:9000

# Managed object storage is intentionally unset here so a copied development
# .env continues to use the MinIO fallback above. For Cloudflare R2 production,
# copy the commented example below into the deployment secret configuration.
# Do not uncomment placeholder credentials in a local .env.
#
# OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_ACCESS_KEY=<r2-access-key-id>
# OBJECT_STORAGE_SECRET_KEY=<r2-secret-access-key>
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_CREATE_BUCKETS=false
# OBJECT_STORAGE_ALLOW_PUBLIC_BUCKETS=false
# OBJECT_STORAGE_BUCKET=bachkhoa-erp-files

# Email (employee account invite/set-password links). Without these, account
# creation still works but the invite email silently fails to send — use the
# "Gửi lại email mời" button once configured, or check backend logs.
# EMAIL_PROVIDER=mailgun — needs a verified domain or manually-authorized
#   recipients (Mailgun dashboard) to send outside your own sandbox test list.
# EMAIL_PROVIDER=gmail_smtp — sends to any recipient immediately using a
#   Gmail account's App Password (myaccount.google.com/apppasswords, requires
#   2-Step Verification enabled first). No domain verification needed.
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=Bach Khoa ERP <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:3000

