# ==============================================================================
# BACHKHOA ERP — FRONTEND CONFIGURATION (.env.example)
# ==============================================================================

# Backend API Base URL
# - Để rỗng '' nếu muốn sử dụng proxy tương đối (/api -> Vite proxy hoặc Nginx reverse proxy)
# - Điền đầy đủ URL nếu frontend kết nối trực tiếp tới server API khác domain/port (ví dụ: http://localhost:8080)
VITE_API_URL=

# Target cho Vite Dev Server Proxy (khi chạy `npm run dev`)
VITE_BACKEND_TARGET=http://127.0.0.1:8080

# Bật chế độ file polling watcher (dùng khi chạy trong Docker/WSL2)
VITE_USE_POLLING=false
